{
    "version": 2,
    "cleanUrls": false,
    "trailingSlash": false,
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "X-Frame-Options", "value": "DENY" },
                { "key": "Server", "value": "NexusEdge/2.1" }
            ]
        }
    ],
    "rewrites": [
        { "source": "/config.php", "destination": "/api/config" },
        { "source": "/login.php", "destination": "/api/login" },
        { "source": "/admin.php", "destination": "/api/admin" },
        { "source": "/api.php", "destination": "/api/api_handler" }
    ]
}
